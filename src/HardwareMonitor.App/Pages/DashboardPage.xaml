<UserControl x:Class="TheSpark.HardwareMonitor.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TheSpark.HardwareMonitor.App.Controls"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Live hardware telemetry" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{DynamicResource NormalBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Freshness}" FontWeight="SemiBold"/></StackPanel></Border></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Border x:Name="CpuCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,10,10"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuName}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding CpuTemperature}" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,2"/><StackPanel Orientation="Horizontal"><TextBlock Text="Load  "/><TextBlock Text="{Binding CpuLoad}" FontWeight="SemiBold"/></StackPanel><controls:AnimatedMetricBar Value="{Binding CpuLoadValue}" Margin="0,8,0,10"/><controls:SparklineControl Values="{Binding CpuHistory}" Stroke="{DynamicResource AccentBrush}" Height="56"/></StackPanel></Border>
                <Border x:Name="GpuCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="10,0,0,10"><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding GpuName}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding GpuTemperature}" FontSize="38" FontWeight="SemiBold" Margin="0,12,0,2"/><StackPanel Orientation="Horizontal"><TextBlock Text="Load  "/><TextBlock Text="{Binding GpuLoad}" FontWeight="SemiBold"/></StackPanel><controls:AnimatedMetricBar Value="{Binding GpuLoadValue}" Margin="0,8,0,10"/><controls:SparklineControl Values="{Binding GpuHistory}" Stroke="{DynamicResource AccentSecondaryBrush}" Height="56"/></StackPanel></Border>
                <Border x:Name="MemoryCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,10,10,0"><StackPanel><TextBlock Text="MEMORY" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding MemoryLoad}" FontSize="34" FontWeight="SemiBold" Margin="0,16,0,8"/><controls:AnimatedMetricBar Value="{Binding MemoryLoadValue}"/></StackPanel></Border>
                <Border x:Name="StorageCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="10,10,0,0"><StackPanel><TextBlock Text="STORAGE" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding StorageTemperature}" FontSize="34" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="Primary drive temperature" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource MetricCard}" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="THERMALS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding ThermalStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ENGINE" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding EngineStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SENSORS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding SensorCount}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
