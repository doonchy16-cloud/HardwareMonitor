<UserControl x:Class="TheSpark.HardwareMonitor.App.Pages.SensorsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="SensorRowTemplate"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding HardwareName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Minimum, StringFormat=Min {0:0.##}}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Grid.Column="3" Text="{Binding Maximum, StringFormat=Max {0:0.##}}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid></Border></DataTemplate>
        <Style x:Key="SensorList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ItemTemplate" Value="{StaticResource SensorRowTemplate}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    </UserControl.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Sensors" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Every exposed sensor, live and timestamped" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged"><TabItem Header="CPU"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding CpuSensors}"/></TabItem><TabItem Header="GPU"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding GpuSensors}"/></TabItem><TabItem Header="Memory"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding MemorySensors}"/></TabItem><TabItem Header="Storage"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding StorageSensors}"/></TabItem><TabItem Header="Motherboard"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding MotherboardSensors}"/></TabItem><TabItem Header="Fans"><ListBox Style="{StaticResource SensorList}" ItemsSource="{Binding FanSensors}"/></TabItem></TabControl></Grid>
</UserControl>
