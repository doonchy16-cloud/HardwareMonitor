<UserControl x:Class="TheSpark.HardwareMonitor.App.Pages.HardwarePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><Style x:Key="InfoCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,10"/></Style></UserControl.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Hardware" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="What is inside this computer" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><TabControl Grid.Row="1"><TabItem Header="Overview"><ScrollViewer><StackPanel><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="SYSTEM" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding SystemModel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding OperatingSystem}" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource AccentSecondaryBrush}"/><TextBlock Text="{Binding Cpu}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding CoreSummary}" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="MEMORY" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Memory}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="CPU"><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="Processor" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Cpu}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,14"/><TextBlock Text="{Binding CoreSummary}"/></StackPanel></Border></TabItem><TabItem Header="GPU"><ItemsControl ItemsSource="{Binding Gpus}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InfoCard}"><TextBlock Text="{Binding}" FontSize="19"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem><TabItem Header="Memory"><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="Installed memory" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Memory}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border></TabItem><TabItem Header="Storage"><ItemsControl ItemsSource="{Binding StorageDevices}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InfoCard}"><TextBlock Text="{Binding}" FontSize="17" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></TabItem><TabItem Header="System"><ScrollViewer><StackPanel><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="Computer name" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding ComputerName}" FontSize="20"/></StackPanel></Border><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="Operating system" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding OperatingSystem}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="Motherboard" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Motherboard}"/></StackPanel></Border><Border Style="{StaticResource InfoCard}"><StackPanel><TextBlock Text="BIOS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Bios}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem></TabControl></Grid>
</UserControl>
