<UserControl x:Class="TheSpark.HardwareMonitor.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings &amp; Diagnostics" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Control Hardware Monitor without slowing it down"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Temperature unit" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Applies to live temperature values."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,4,0,10"/>
                                <ComboBox x:Name="TemperatureUnitCombo"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="TemperatureUnitCombo_SelectionChanged">
                                    <ComboBoxItem Content="Celsius"/>
                                    <ComboBoxItem Content="Fahrenheit"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Windows startup" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Startup is managed by Windows so it remains package-safe across updates."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <Button Content="Open Startup Apps"
                                        HorizontalAlignment="Left"
                                        Click="OpenStartupApps_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer>
                    <StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SettingTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Light" Tag="Light" Click="Theme_Click" Margin="0,0,8,0"/>
                                    <Button Content="Dark" Tag="Dark" Click="Theme_Click" Margin="0,0,8,0"/>
                                    <Button Content="⚡ Forgey Core" Tag="Forgey Core" Click="Theme_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Motion" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Full keeps the complete animation system; Reduced shortens motion; Off keeps telemetry fully active without decorative motion."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <ComboBox x:Name="MotionCombo"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="MotionCombo_SelectionChanged">
                                    <ComboBoxItem Content="Full"/>
                                    <ComboBoxItem Content="Reduced"/>
                                    <ComboBoxItem Content="Off"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Monitoring">
                <ScrollViewer>
                    <StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Refresh interval" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Controls the live window sensor refresh. The background agent uses this cadence when it starts."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <ComboBox x:Name="PollCombo"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="PollCombo_SelectionChanged">
                                    <ComboBoxItem Content="500 ms" Tag="500"/>
                                    <ComboBoxItem Content="1 second" Tag="1000"/>
                                    <ComboBoxItem Content="2 seconds" Tag="2000"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Background monitoring" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="The separate agent keeps collecting telemetry after this window closes. Turning automatic start off prevents future launches but does not terminate an agent that is already running."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <CheckBox x:Name="BackgroundAgentCheckBox"
                                          Content="Start background agent when Hardware Monitor opens"
                                          Click="BackgroundAgentCheckBox_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer>
                    <StackPanel>
                        <Border Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sensor engine" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding EngineStatus}" FontSize="22" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Detected" Foreground="{DynamicResource MutedTextBrush}"/>
                                    <TextBlock FontSize="22" FontWeight="SemiBold">
                                        <Run Text="{Binding DeviceCount}"/>
                                        <Run Text=" devices / "/>
                                        <Run Text="{Binding SensorCount}"/>
                                        <Run Text=" sensors"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Background agent" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock x:Name="AgentStateText" Text="Checking…" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AgentDetailsText"
                                           Text="Waiting for local agent health."
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="RefreshAgentButton"
                                            Content="Refresh Agent Status"
                                            Click="RefreshAgent_Click"
                                            Margin="0,0,8,0"/>
                                    <Button x:Name="RestartAgentButton"
                                            Content="Start / Restart Agent"
                                            Click="RestartAgent_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Last refresh" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="{Binding LastRefresh}" Foreground="{DynamicResource MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Restart Sensor Engine" Click="RestartEngine_Click" Margin="0,0,8,0"/>
                                    <Button Content="Copy Diagnostic Report" Click="CopyDiagnostics_Click" Margin="0,0,8,0"/>
                                    <Button Content="Repair Installation" Click="Repair_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Hardware Monitor" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="by The Spark"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"
                                   FontSize="16"
                                   Margin="0,3,0,18"/>
                        <TextBlock x:Name="VersionText" FontSize="16"/>
                        <TextBlock Text="Channel: stable" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
                        <TextBlock Text="Package: TheSpark.HardwareMonitor" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Button Content="Check for Updates" HorizontalAlignment="Left" Margin="0,18,0,0" Click="CheckUpdates_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>