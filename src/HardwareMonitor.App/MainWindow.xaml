<Window x:Class="TheSpark.HardwareMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor" Width="1180" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="20">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BurgerButton" Content="🍔" Width="46" Height="42" Padding="0" FontSize="24" Background="Transparent" BorderThickness="0" Click="BurgerButton_Click"><Button.RenderTransform><ScaleTransform x:Name="BurgerScale" CenterX="23" CenterY="21"/></Button.RenderTransform></Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Hardware Monitor" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="  by The Spark" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="HeaderLiveDot" Width="8" Height="8" Fill="{DynamicResource NormalBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding Freshness}" FontWeight="SemiBold"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl x:Name="PageHost" />
            <Border x:Name="Scrim" Background="#7A000000" Opacity="0" Visibility="Collapsed" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" Panel.ZIndex="30" />
            <Border x:Name="Drawer" Width="290" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Panel.ZIndex="40">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerTransform" X="-300"/></Border.RenderTransform>
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="4,12,4,24"><TextBlock Text="Hardware Monitor" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="THE SPARK" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource NavButton}" Content="◉   Dashboard" Tag="Dashboard" Click="NavButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🌡   Sensors" Tag="Sensors" Click="NavButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🖥   Hardware" Tag="Hardware" Click="NavButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙   Settings &amp; Diagnostics" Tag="Settings" Click="NavButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="4,18,4,8"><TextBlock Text="v1.0.0 · stable" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="Telemetry stays local" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
