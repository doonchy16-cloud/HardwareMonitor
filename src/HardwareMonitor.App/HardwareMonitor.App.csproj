    <ProjectReference Include="..\HardwareMonitor.Diagnostics\HardwareMonitor.Diagnostics.csproj" />
    <ProjectReference Include="..\HardwareMonitor.Platform.Windows\HardwareMonitor.Platform.Windows.csproj" />
    <ProjectReference Include="..\HardwareMonitor.Sensors\HardwareMonitor.Sensors.csproj" />
  </ItemGroup>
</Project>
