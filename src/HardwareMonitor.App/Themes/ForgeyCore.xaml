<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TheSpark.HardwareMonitor.App.Controls">
    <SolidColorBrush x:Key="WindowBackground" Color="#08040F" /><SolidColorBrush x:Key="SurfaceBrush" Color="#130A20" /><SolidColorBrush x:Key="SurfaceAltBrush" Color="#201030" /><SolidColorBrush x:Key="TextBrush" Color="#FFF9EE" /><SolidColorBrush x:Key="MutedTextBrush" Color="#BFAECD" /><SolidColorBrush x:Key="BorderBrush" Color="#4C2368" /><SolidColorBrush x:Key="AccentBrush" Color="#A855F7" /><SolidColorBrush x:Key="AccentSecondaryBrush" Color="#F59E0B" /><SolidColorBrush x:Key="NormalBrush" Color="#A855F7" /><SolidColorBrush x:Key="WarmBrush" Color="#F59E0B" /><SolidColorBrush x:Key="CriticalBrush" Color="#FF4D73" /><DropShadowEffect x:Key="GlowEffect" BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="#A855F7" />
    <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource WindowBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style><Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Effect" Value="{DynamicResource GlowEffect}"/></Style><Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/></Style><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,6,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}"/><Setter Property="Background" Value="#341445"/><Setter Property="Effect" Value="{DynamicResource GlowEffect}"/></Trigger></Style.Triggers></Style><Style TargetType="controls:AnimatedMetricBar"><Setter Property="Height" Value="8"/><Setter Property="Effect" Value="{DynamicResource GlowEffect}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:AnimatedMetricBar"><Border Background="#24102F" CornerRadius="4" ClipToBounds="True"><Grid Width="100" HorizontalAlignment="Left"><Border x:Name="PART_Fill" Width="0" HorizontalAlignment="Left" CornerRadius="4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A855F7" Offset="0"/><GradientStop Color="#F59E0B" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
