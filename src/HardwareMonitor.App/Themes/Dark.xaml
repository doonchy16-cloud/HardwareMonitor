<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TheSpark.HardwareMonitor.App.Controls">
    <SolidColorBrush x:Key="WindowBackground" Color="#0B0E14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141922" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B2230" />
    <SolidColorBrush x:Key="TextBrush" Color="#F7F7FB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA7B8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#283143" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="NormalBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="WarmBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#F43F5E" />
    <DropShadowEffect x:Key="GlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#8B5CF6" />

    <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource WindowBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" /></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="14,8" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent" /></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="14,8" /><Setter Property="Margin" Value="0,0,6,0" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /></Trigger></Style.Triggers></Style>
    <Style TargetType="controls:AnimatedMetricBar"><Setter Property="Height" Value="8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:AnimatedMetricBar"><Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" ClipToBounds="True"><Grid Width="100" HorizontalAlignment="Left"><Border x:Name="PART_Fill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="4" /></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
