<Window x:Class="TheSpark.HardwareMonitor.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Monitor Setup" Icon="Assets/AppIcon.png"
        Width="620" Height="520" MinWidth="560" MinHeight="470"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="92" Height="92" CornerRadius="22" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Image Source="Assets/AppIcon.png" Width="80" Height="80" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="20,5,0,0">
                <TextBlock Text="Hardware Monitor" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Setup by The Spark" Foreground="{StaticResource AmberBrush}" FontSize="14" Margin="0,4,0,0" />
                <TextBlock Text="Hardware telemetry · temperatures · live diagnostics" Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,26,0,20" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Ready to install" FontSize="19" FontWeight="SemiBold" x:Name="HeadingText" />
                    <TextBlock Text="One setup handles the sensor driver, Windows app installation, automatic updates, repair path, and Desktop shortcut." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" LineHeight="20" />
                </StackPanel>

                <ProgressBar Grid.Row="1" x:Name="Progress" Height="6" Margin="0,22,0,20" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource PurpleBrush}" Background="#2A2937" />

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="StatusText" Text="Hardware Monitor will install for this Windows user." TextWrapping="Wrap" FontSize="14" />
                    <TextBlock Text="• PawnIO 2.2.0 is installed only if required and its SHA-256 is verified." Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="• Hardware Monitor installs through Windows App Installer so automatic updates remain registered." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="• A Desktop shortcut is created and the app launches when setup finishes." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="InstallButton" Content="Install / Repair" Click="InstallButton_Click" Padding="22,11" MinWidth="140" FontSize="14" FontWeight="SemiBold" Background="{StaticResource PurpleBrush}" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Text="Windows 10 2004+ / Windows 11 · x64 · telemetry stays local" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
            <Border x:Name="SparkDot" HorizontalAlignment="Right" Width="9" Height="9" CornerRadius="5" Background="{StaticResource AmberBrush}" />
        </Grid>
    </Grid>
</Window>
